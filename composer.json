{
    "name": "omnipost/youtube",
    "type": "library",
    "description": "Omnipost YouTube: the channel's videos through the Data API (a key), and Shorts uploaded through OAuth.",
    "keywords": ["social", "youtube", "shorts", "omnipost"],
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0",
        "omnisense/omnipost": "^1.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Omnipost\\YouTube\\": ""},
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": {"Omnipost\\YouTube\\Tests\\": "Tests/"}
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        },
        "omnisense": {"policy": "policy.json"}
    },
    "config": {"sort-packages": true}
}
