			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Cannot access property \$titleRequired on mixed\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 2
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Method Omnipost\\YouTube\\Tests\\YouTubeProviderTest\:\:json\(\) has parameter \$data with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Method Omnipost\\YouTube\\Tests\\YouTubeProviderTest\:\:provider\(\) has parameter \$options with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Method Omnipost\\YouTube\\Tests\\YouTubeProviderTest\:\:provider\(\) should return Omnipost\\YouTube\\YouTubeProvider but returns Omnipost\\ProviderInterface\.$#'
			identifier: return.type
			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Method Omnipost\\YouTube\\Tests\\YouTubeProviderTest\:\:uploaded\(\) has parameter \$status with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Parameter \#1 \$options of method Omnipost\\ProviderFactory\:\:create\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Parameter \#2 \$string of function explode expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Property Omnipost\\YouTube\\Tests\\YouTubeProviderTest\:\:\$calls \(list\<array\{method\: string, url\: string, path\: string, query\: array\<string, string\>, headers\: array\<string, string\>, body\: string\}\>\) does not accept non\-empty\-list\<array\{method\: string, url\: string, path\: string, query\: array\<int\|string, array\<mixed\>\|string\>, headers\: array\<string, string\>, body\: string\}\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: YouTubeProvider.php

		-
			message: '#^Parameter \#1 \$array \(list\<string\>\) of array_values is already a list, call has no effect\.$#'
