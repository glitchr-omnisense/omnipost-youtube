			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Binary operation "\.\=" between string and mixed results in an error\.$#'
			identifier: assignOp.invalid
			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Call to an undefined method Omnipost\\ProviderInterface\:\:account\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Call to an undefined method Omnipost\\ProviderInterface\:\:capabilities\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: Tests/YouTubeProviderTest.php

