			message: '#^Call to an undefined method Omnipost\\ProviderInterface\:\:feed\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Call to an undefined method Omnipost\\ProviderInterface\:\:publish\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: Tests/YouTubeProviderTest.php

		-
			message: '#^Cannot access offset ''description'' on mixed\.$#'
